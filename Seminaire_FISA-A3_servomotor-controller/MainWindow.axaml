<Window x:Class="ServoMotorControl.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ServoMotorControl"
        mc:Ignorable="d"
        Title="Contrôle ServoMotor Arduino" Height="400" Width="400"
        KeyDown="Window_Arrow_Key">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Titre -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Contrôle ServoMotor" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- Port COM -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Port COM:" VerticalAlignment="Center"/>
        <ComboBox x:Name="comPortComboBox" Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" Width="150"/>

        <!-- Bouton Connexion -->
        <Button x:Name="connectButton" Grid.Row="2" Grid.ColumnSpan="2" Content="Se connecter" Width="120" HorizontalAlignment="Center" Margin="0,10,0,10" Click="ConnectButton_Click"/>

        <TextBlock x:Name="statusTextBlock" Grid.Row="3" Grid.ColumnSpan="2" VerticalAlignment="Center"/>
        
        <!-- Slider Angle -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Angle (°):" VerticalAlignment="Center"/>
        <Slider x:Name="angleSlider" IsVisible="False" TickFrequency="5" IsSnapToTickEnabled="True"
                Minimum="0" Maximum="180" Value="90" ValueChanged="AngleSlider_ValueChanged"/>
        <Canvas x:Name="gaugeCanvas" Grid.Row="4" Grid.ColumnSpan="2" Width="200" Height="110"
                Background="Transparent" HorizontalAlignment="Center"
                PointerPressed="Gauge_PointerPressed" PointerMoved="Gauge_PointerMoved">
            <Path Data="M 10,100 A 90,90 0 0 1 190,100" Stroke="Gray" StrokeThickness="14" StrokeLineCap="Round"/>
            <Path x:Name="gaugeFill" Stroke="Aqua" StrokeThickness="14" StrokeLineCap="Round"/>
            <Line x:Name="gaugeNeedle" Stroke="OrangeRed" StrokeThickness="3" StartPoint="100,100" EndPoint="100,20"/>
            <Ellipse Canvas.Left="94" Canvas.Top="94" Width="12" Height="12" Fill="OrangeRed"/>
        </Canvas>
        <!-- Affichage Angle -->
        <TextBlock x:Name="angleTextBlock" Grid.Row="5" Grid.ColumnSpan="2" Text="Angle actuel: 90°" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
    </Grid>
</Window>