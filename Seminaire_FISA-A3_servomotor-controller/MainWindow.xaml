<Window x:Class="ServoMotorControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ServoMotorControl"
        mc:Ignorable="d"
        Title="Contrôle ServoMotor Arduino"  Height="300" Width="400" Background="Black">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Titre -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Contrôle ServoMotor" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="Yellow"/>

        <!-- Port COM -->
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="40,0,0,0" Text="Port COM:" VerticalAlignment="Center" Foreground="Yellow"/>
        <ComboBox x:Name="comPortComboBox" Grid.Row="1" Grid.ColumnSpan="2" Margin="10,0,0,0" Width="150" HorizontalAlignment="Center" Foreground="Black" Background="Yellow">
            <!-- On redéfinit l'apparence de la ComboBox, car le thème Windows par défaut
                 ignore la propriété Background (la zone fermée reste grise). -->
            <ComboBox.Template>
                <ControlTemplate TargetType="ComboBox">
                    <!-- Grid : les 3 éléments ci-dessous sont superposés au même endroit -->
                    <Grid>
                        <!-- Zone cliquable Yellow + flèche noire.
                             ClickMode="Press" : la liste s'ouvre dès l'appui du clic.
                             IsChecked est lié dans les deux sens à IsDropDownOpen :
                             cliquer ouvre/ferme la liste, et la liste fermée décoche le bouton. -->
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <!-- Apparence du bouton : un simple cadre Yellow (sans effet de survol Windows) -->
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Yellow" BorderBrush="Yellow" BorderThickness="1" CornerRadius="3">
                                        <!-- Petite flèche (triangle pointe en bas) dessinée à droite -->
                                        <Path Data="M0,0 L4,4 L8,0 Z" Fill="Black" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <!-- Affichage de l'item sélectionné, en noir, par-dessus le bouton.
                             SelectionBoxItem = l'item actuellement choisi.
                             Marge droite de 24 pour ne pas passer sous la flèche.
                             IsHitTestVisible="False" : le clic passe à travers jusqu'au bouton. -->
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="6,3,24,3"
                                          VerticalAlignment="Center" IsHitTestVisible="False" TextElement.Foreground="Black"/>
                        <!-- Liste déroulante : fenêtre flottante (Popup) affichée sous la ComboBox
                             quand IsDropDownOpen est vrai. Au moins aussi large que la ComboBox. -->
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                            <Border Background="Yellow" BorderBrush="Yellow" BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}">
                                <!-- Barre de défilement si la liste dépasse 200 px de haut -->
                                <ScrollViewer MaxHeight="200">
                                    <!-- ItemsPresenter : endroit où WPF place les items (ports COM) -->
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </ComboBox.Template>
            <!-- Style appliqué à chaque item de la liste : fond Yellow, texte noir -->
            <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background" Value="Yellow"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Style>
            </ComboBox.ItemContainerStyle>
        </ComboBox>

        <!-- Bouton Connexion -->
        <Button x:Name="connectButton" Grid.Row="2" Grid.ColumnSpan="2" Content="Se connecter" Width="120" HorizontalAlignment="Center" Margin="0,10,0,10" Click="ConnectButton_Click" Foreground="Black" Background="Yellow"/>

        <!-- Slider Angle -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Angle (°):" VerticalAlignment="Center"/>
        <Slider x:Name="angleSlider" Grid.Row="3" Grid.ColumnSpan="2" Minimum="5" Maximum="120" Value="60" Width="150" Margin="10,0,0,0" ValueChanged="AngleSlider_ValueChanged" HorizontalAlignment="Center">
            <!-- Redéfinition de l'apparence du Slider -->
            <Slider.Template>
                <ControlTemplate TargetType="Slider">
                    <!-- Grid de 20 px de haut : la barre et le curseur sont superposés -->
                    <Grid Height="20">
                        <!-- Barre horizontale Yellow de 4 px, aux bords arrondis -->
                        <Border Height="4" Background="Yellow" CornerRadius="2"/>
                        <!-- Track : gère la position du curseur selon Value/Minimum/Maximum.
                             Le nom PART_Track est obligatoire : WPF s'en sert pour faire
                             fonctionner le glissement et déclencher ValueChanged. -->
                        <Track x:Name="PART_Track">
                            <Track.Thumb>
                                <!-- Thumb : le curseur que l'on fait glisser (14 x 14 px) -->
                                <Thumb Width="14" Height="14">
                                    <!-- Apparence du curseur : un rond Yellow cerclé de blanc -->
                                    <Thumb.Template>
                                        <ControlTemplate>
                                            <Ellipse Fill="Black" Stroke="Yellow"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Slider.Template>
        </Slider>

        <!-- Affichage Angle -->
        <TextBlock x:Name="angleTextBlock" Grid.Row="4" Grid.ColumnSpan="2" Text="Angle actuel: 90°" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="Yellow"/>
    </Grid>
</Window>