<Window x:Class="ServoMotorControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ServoMotorControl"
        mc:Ignorable="d"
        Title="Contrôle ServoMotor Arduino" Height="480" Width="560">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <TextBlock Grid.Row="0" Text="Contrôle ServoMotor" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- Port COM : la liste doit pouvoir être rechargée, la carte est
             souvent branchée après le lancement de l'application. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Port COM:" VerticalAlignment="Center"/>
            <ComboBox x:Name="comPortComboBox" Width="150" Margin="10,0,0,0"/>
            <Button x:Name="refreshButton" Content="Rafraîchir" Width="80" Margin="8,0,0,0" Click="RefreshButton_Click"/>
        </StackPanel>

        <!-- Bouton Connexion -->
        <Button x:Name="connectButton" Grid.Row="2" Content="Se connecter" Width="120" HorizontalAlignment="Center" Margin="0,12,0,12" Click="ConnectButton_Click"/>

        <!-- Une ligne par servomoteur, donc par seringue. Le nombre de voies
             est défini dans le code derrière et doit correspondre à
             SERVO_COUNT dans le sketch Arduino. -->
        <ItemsControl x:Name="channelsItemsControl" Grid.Row="3">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="55"/>
                        </Grid.ColumnDefinitions>

                        <!-- Le mouvement de grue d'abord, le câblage en dessous :
                             l'opérateur raisonne en « lever » ou « orienter »,
                             pas en numéro de broche. -->
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Role}" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#777777" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Les bornes viennent de la voie : elles sont alignées
                             sur l'écrêtage appliqué par la carte. -->
                        <Slider Grid.Column="1"
                                Minimum="{Binding Minimum}"
                                Maximum="{Binding Maximum}"
                                Value="{Binding Angle, Mode=TwoWay}"
                                TickFrequency="15"
                                TickPlacement="BottomRight"
                                VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="2" Text="{Binding AngleText}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="14"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Journal : réponses de la carte (OK / ERR) et état de la liaison. -->
        <Border Grid.Row="4" Margin="0,18,0,0" BorderBrush="#CCCCCC" BorderThickness="1" Padding="8">
            <TextBlock x:Name="statusTextBlock" Text="Non connecté." TextWrapping="Wrap" VerticalAlignment="Top" Foreground="#444444"/>
        </Border>
    </Grid>
</Window>
